#!/usr/bin/env bash
set -euo pipefail

# --- Knobs: REVIEW_HOOK_* with a CODEX_HOOK_* fallback -----------------------
# What:  read each knob under its new REVIEW_HOOK_ name, then the legacy CODEX_HOOK_ name,
#        then the default; say so once when the legacy name supplied the value.
# Why:   the same hook exists downstream with more than one review provider, where a name
#        hard-coding "codex" is simply wrong. Two copies of one hook drifting to two different
#        variable names is how a stamped fleet ends up needing two migrations, so the kit takes
#        the same names — and, more importantly, the same fallback, so nothing already set under
#        the old name stops taking effect on the day a repo upgrades.
review_hook_knob() {
  local suffix="$1" default="$2"
  local new="REVIEW_HOOK_${suffix}" old="CODEX_HOOK_${suffix}"
  if [ -n "${!new:-}" ]; then
    printf '%s' "${!new}"
  elif [ -n "${!old:-}" ]; then
    echo "[codex-hook] ${old} is deprecated — rename it to ${new}." >&2
    printf '%s' "${!old}"
  else
    printf '%s' "$default"
  fi
}

# A numeric knob reaches $(( )) and [ -gt ], and set -e is active: TIMEOUT_SECONDS=180s would be
# a fatal arithmetic error, so the hook exits non-zero and git aborts the commit. A typo in one
# knob must not become a commit freeze across every stamped repo — fall back and say so.
review_hook_int_knob() {
  local value
  value=$(review_hook_knob "$1" "$2")
  case "$value" in
    ''|*[!0-9]*)
      echo "[codex-hook] ${1}='${value}' is not a non-negative integer — using ${2}." >&2
      printf '%s' "$2"
      ;;
    *) printf '%s' "$value" ;;
  esac
}

# Classify a Codex review into a gate decision. Reads the review on stdin, echoes
# one of: block | drift | lgtm | clean. Split out from the gate below so it can be
# exercised directly — see hooks/git-pre-commit.test.sh. Every bug this function
# encodes was a commit that passed while the hook printed success.
codex_verdict() {
  local out; out="$(cat)"
  # A marker inside single-line backticks is the review TALKING ABOUT the syntax,
  # not raising a finding — "blocks on every `[P0-9]` substring". Reviewing this
  # very file produces reviews full of that, so strip those spans before matching.
  # Deliberately narrow: markers are NOT required to start a line, because a real
  # finding can sit mid-sentence ("LGTM apart from the [P1] below") and anchoring
  # to line starts would hand back exactly the bypass this function exists to close.
  #
  # This ONE strip is the whole sanitizer, and that is the point. Earlier versions
  # also dropped ``` fenced blocks wholesale and every double-quoted span, which
  # reopened the hole this function exists to close from the other side: a review
  # that fences its findings, or returns them as JSON ("title":"[P1] ..."), had
  # every marker erased before matching and came out `clean`. A sanitizer that can
  # delete the only evidence of a finding is a fail-open path, so it is gone.
  # A marker in a fenced or quoted span therefore BLOCKS. That costs a false block
  # when a review quotes a marker at this file; a human reads it and moves on.
  # The reverse error — a silent pass on a real finding — is the one that ships.
  # Fences are parsed, not split on. A run of three or more opens one, and only a run AT LEAST AS
  # LONG closes it — a four-backtick fence may legally contain a literal three-backtick run, and
  # treating that shorter run as a boundary flipped the parser to "outside", where the inline
  # strip then removed a real marker and a trailing sign-off approved the finding.
  #
  # Outside a fence, a marker in single backticks is a mention of the syntax, not a finding: a
  # review discussing this file produces those constantly, and blocking on them blocks the
  # reviewer. Inside one, nothing is ever removed — a sanitizer able to delete the only evidence
  # of a finding is a fail-open path, which is how this function used to come out `clean` on a
  # review that fenced its findings. An unterminated fence leaves its tail classed as inside,
  # i.e. preserved, which is the safe direction.
  local scan; scan="$(printf '%s' "$out" | awk '
    { buf = buf $0 "\n" }
    END {
      rest = buf; inside = 0; openlen = 0
      while (match(rest, /`{3,}/)) {
        pre  = substr(rest, 1, RSTART - 1)
        run  = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART + RLENGTH)
        if (inside == 0) {
          gsub(/`[^`]*`/, "", pre)          # outside a fence: an inline span is a mention
          printf "%s\001", pre
          inside = 1; openlen = RLENGTH
        } else if (RLENGTH >= openlen) {    # only a run at least as long as the opener closes it
          printf "%s\001", pre
          inside = 0; openlen = 0
        } else {                            # a SHORTER run is fence content, not a boundary
          printf "%s%s", pre, run
        }
      }
      if (inside == 0) gsub(/`[^`]*`/, "", rest)
      printf "%s", rest
    }')"
  # Findings FIRST. The approval check used to run first, unanchored and
  # case-insensitive, so "LGTM apart from the [P1] SQL injection below" exited 0
  # before [P1] was ever examined — as did Codex merely QUOTING a diff line
  # containing the word ("// LGTM once tests pass").
  if printf '%s' "$scan" | grep -qE '\[P[0-9]\]'; then echo block; return; fi
  # Priority-shaped text that lost its brackets. Positive evidence of findings in
  # a shape this gate cannot parse is NOT the same as Codex being unavailable, so
  # it blocks rather than falling open — previously it printed "no issues flagged".
  # Matches mid-sentence too ("the remaining P1: ..."), not just at a line start.
  # The separator is what distinguishes a finding from prose that merely names a
  # tier: a hyphen counts only with whitespace BOTH sides ("- P3 - nit"), never
  # glued to a word, or "No P1-level concern is evident" — an ordinary clean
  # review — would block. A bare token with no separator at all ("one P2 concern
  # remains") is deliberately NOT matched: nothing lexical separates it from
  # prose, and blocking every review that mentions a priority level is how this
  # gate would get switched off for good. Pinned in both directions by tests.
  if printf '%s' "$scan" | grep -qE 'P[0-9]([[:space:]]*[:.)]|[[:space:]]+-[[:space:]])'; then echo drift; return; fi
  # An approval must be the review's own verdict, at the start of a line.
  if printf '%s' "$out" | grep -qE '^[[:space:]]*(#{1,6}[[:space:]]*|[-*][[:space:]]*)?LGTM\b'; then echo lgtm; return; fi
  # No markers at all is treated as a genuine clean review, NOT a parse failure.
  #
  # The original reason for that was: `codex exec review` imposes its own output schema and
  # ignores appended format demands — an added "end with VERDICT: CLEAN|ISSUES" instruction was
  # never once echoed — so requiring a positive approval token would alarm on EVERY clean commit,
  # and an alarm that cries wolf every time is how the real one gets ignored.
  #
  # RE-CHECKED 2026-08-28 and that premise no longer holds: on gpt-5.6-terra at medium effort,
  # codex honoured an explicit verdict-line instruction on the first try, in both directions
  # ("VERDICT: LGTM" on a clean diff, "[P1] … VERDICT: CHANGES_REQUIRED" on a shell-injection
  # one). The original finding was against this hook's own default, gpt-5.4-mini at low effort.
  # So this is now a MODEL-DEPENDENT assumption, not a property of codex.
  #
  # The behaviour is deliberately left as-is anyway: requiring the token here would make the
  # verdict contract load-bearing for every stamped repo on whatever model it happens to run,
  # and a repo pinned to a weaker model would have every clean commit reported inconclusive.
  # Requiring it is a change to make WITH the model floor, not before it. Re-measure before
  # hardening — and re-measure per model, not once.
  echo clean
}

# Sourced by the test suite to reach codex_verdict() without running the gate.
if [ -n "$(review_hook_knob LIB_ONLY '')" ]; then return 0 2>/dev/null || exit 0; fi

# --- Dependency justification check (advisory; set DEP_JUSTIFICATION_ENFORCE=1 to hard-block) ---
# Runs before the Codex review so dep-related issues surface early.
# Honors bypass tokens "deps:noop|cleanup|reorder" in the commit body.
# ${HOME:-} rather than $HOME: `set -u` makes a bare expansion abort the whole hook where HOME is
# unset (a minimal CI image, a sanitized git environment), so an optional advisory check would
# take every commit down with it.
if [ -x "${HOME:-}/.config/git/hooks/dep-justification-check.sh" ]; then
  "${HOME:-}/.config/git/hooks/dep-justification-check.sh" || true
fi

# --- quality-kit validate:fast (generic; replaces per-repo hacks) ---
# Cheap deterministic gate BEFORE the Codex review: a red validate:fast should
# never spend a Codex call. Repos opt in by being stamped (.quality-kit.json).
QK_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$QK_ROOT" ] && [ -f "$QK_ROOT/.quality-kit.json" ]; then
  QK_RUNNER="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('runner','npm'))" "$QK_ROOT/.quality-kit.json" 2>/dev/null || echo npm)"
  echo "[quality-kit] validate:fast (runner: $QK_RUNNER)..."
  # Scrub the inherited git context, exactly as the Codex call below already does.
  # git exports GIT_DIR/GIT_INDEX_FILE to every hook, and validate:fast runs the
  # repo's OWN test suite — any test that shells out to git in a temp repo then
  # silently operates on THIS repo instead. That is not hypothetical: it fails 45
  # of harness's tests, and only ever inside a commit, so the suite looks broken
  # rather than mis-scoped.
  QK_GIT_SCRUB=(env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX
                -u GIT_AUTHOR_DATE -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL
                -u GIT_EDITOR -u GIT_CONFIG_PARAMETERS)
  case "$QK_RUNNER" in
    npm)  (cd "$QK_ROOT" && "${QK_GIT_SCRUB[@]}" npm run --silent validate:fast) ;;
    make) (cd "$QK_ROOT" && "${QK_GIT_SCRUB[@]}" make validate-fast) ;;
    *)    true ;;
  esac || {
    echo "[quality-kit] BLOCKED — validate:fast failed. Fix and retry the commit." >&2
    exit 1
  }
fi

# --- Codex pre-commit review hook (global) ---
# Runs Codex review on staged changes for all repos.
# In interactive mode: prompts user. In non-interactive (Claude Code): blocks with structured output.
# Bypass with: git commit --no-verify

# Reason the review gate did not run, set by every skip path; consumed by gate_skipped.
SKIP_REASON="unknown"

# What:  classify a skip as "the review was unavailable" vs "this diff is not reviewable".
# Why:   the two want different answers. A provider failure is an outage — retrying later works,
#        and it is the case a strict caller wants to block on. A structural skip means the diff
#        cannot be reviewed in the form it is in; no retry and no second provider rescues it, so
#        blocking it wedges legitimate work with no way out. Recorded now so the choice of a
#        default can be made from counts rather than from argument.
skip_reason_class() {
  case "$1" in
    oversize_diff|oversize_plan_diff|plan_doc_advisory) printf 'structural' ;;
    *)                                                  printf 'provider_failure' ;;
  esac
}

# The strict switch travels with the stamp, not just the environment: a repo that must not
# accept ungated commits should keep saying so after a fresh clone, a new machine, or a CI
# runner that never sourced anyone's shell profile. An explicit env var still wins, so a
# one-off `REVIEW_HOOK_REQUIRE_GATE=0 git commit` remains possible.
require_gate_from_stamp() {
  [ -n "${QK_ROOT:-}" ] && [ -f "$QK_ROOT/.quality-kit.json" ] || { printf '0'; return; }
  python3 -c "import json,sys;print('1' if json.load(open(sys.argv[1])).get('requireGate') else '0')" \
    "$QK_ROOT/.quality-kit.json" 2>/dev/null || printf '0'
}

REVIEW_HOOK_REQUIRE_GATE=$(review_hook_knob REQUIRE_GATE "$(require_gate_from_stamp)")

# What:  emit the machine-readable gate verdict, and honour REVIEW_HOOK_REQUIRE_GATE.
# Where: EVERY path that reaches a commit without a completed review.
# Why:   without this line nothing downstream can tell "reviewed, clean" from "never ran". The
#        failure that motivated it was a sandbox that could not initialise — not a blip but a
#        property of the environment, so it recurs on every commit while the gate goes on looking
#        installed. The fail-open DEFAULT is unchanged; what changes is that the skip is now
#        visible, classifiable, countable, and refusable by a caller that needs a real gate.
gate_skipped() {
  local reason="${1:-${SKIP_REASON:-unknown}}"
  local class
  class=$(skip_reason_class "$reason")
  echo "[codex-hook] GATE_SKIPPED reason=${reason}"

  # Best-effort, always. A gate that blocks commits because its own state directory is
  # unwritable is worse than the problem it measures.
  # `set -u` is active, so a bare $HOME fallback ABORTS the hook where HOME is unset — a minimal
  # CI image or a sanitized git environment — and every skipped review would then block the
  # commit, in the documented fail-open default. Derive the root guarded, and simply do not log
  # when there is nowhere to log to.
  local state_root="${XDG_STATE_HOME:-${HOME:+$HOME/.local/state}}"
  if [ -n "$state_root" ]; then
    local log_dir="${state_root}/quality-kit"
    local log_file="${log_dir}/gate-skips.log"
    local repo branch
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || repo="unknown"
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch="unknown"
    mkdir -p "$log_dir" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" "$repo" "$branch" \
      "$class" >>"$log_file" 2>/dev/null || true
  fi

  # Strict mode refuses an OUTAGE, not an unreviewable diff. Blocking a structural skip would
  # wedge legitimate work with no way out — there is no retry and no other reviewer that makes an
  # oversized diff reviewable, and a plan-only commit is advisory by design, so a strict repo
  # could never land one at all. Those are still logged; they are just not a reason to refuse.
  if [ "$REVIEW_HOOK_REQUIRE_GATE" = "1" ] && [ "$class" = "provider_failure" ]; then
    echo "[codex-hook] BLOCKED — REVIEW_HOOK_REQUIRE_GATE=1 and the review gate did not run (${reason})."
    echo "[codex-hook] This repo requires a real gate. Retry when the reviewer is available,"
    echo "[codex-hook] or unset the variable to accept an ungated commit."
    exit 1
  fi
  echo "[codex-hook] Proceeding without the Codex review gate."
}

# Ensure codex is available
if ! command -v codex &>/dev/null; then
  echo "[codex-hook] codex CLI not found — skipping review."
  gate_skipped "codex_unavailable"
  exit 0
fi

# Only review if there are staged changes
if git diff --cached --quiet; then
  exit 0
fi

# Codex can hang indefinitely when fed very large stdin payloads. Keep the diff
# on disk, cap the payload size, and enforce a hard timeout on review.
REVIEW_HOOK_TIMEOUT_SECONDS=$(review_hook_int_knob TIMEOUT_SECONDS 180)
REVIEW_HOOK_MAX_DIFF_BYTES=$(review_hook_int_knob MAX_DIFF_BYTES 200000)
REVIEW_HOOK_MODEL=$(review_hook_knob MODEL gpt-5.4-mini)
REVIEW_HOOK_REASONING_EFFORT=$(review_hook_knob REASONING_EFFORT low)

STAGED_FILES=$(git diff --cached --name-only)
DIFF_FILE=$(mktemp /tmp/codex-hook-diff.XXXXXX)
PROMPT_FILE=$(mktemp /tmp/codex-hook-prompt.XXXXXX)
OUTPUT_FILE=$(mktemp /tmp/codex-hook-output.XXXXXX)
TRANSCRIPT_FILE=$(mktemp /tmp/codex-hook-transcript.XXXXXX)

cleanup() {
  rm -f "$DIFF_FILE" "$PROMPT_FILE" "$OUTPUT_FILE" "$TRANSCRIPT_FILE"
}
trap cleanup EXIT

git diff --cached >"$DIFF_FILE"
STAGED_DIFF_BYTES=$(wc -c <"$DIFF_FILE" | tr -d '[:space:]')

run_codex_review() {
  local prompt_file="$1"
  local output_file="$2"

  set +e
  /usr/bin/perl -e '
    use strict;
    use warnings;

    my $timeout = shift @ARGV;
    my $pid = fork();
    die "fork failed\n" unless defined $pid;

    if ($pid == 0) {
      exec @ARGV;
      exit 127;
    }

    local $SIG{ALRM} = sub {
      kill "TERM", $pid;
      select undef, undef, undef, 0.2;
      kill "KILL", $pid;
      waitpid $pid, 0;
      exit 124;
    };

    alarm $timeout;
    waitpid $pid, 0;
    my $status = $?;
    alarm 0;

    if ($status == -1) {
      exit 125;
    }

    if ($status & 127) {
      exit 128 + ($status & 127);
    }

    exit $status >> 8;
  ' \
    "$REVIEW_HOOK_TIMEOUT_SECONDS" \
    env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_AUTHOR_DATE -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL -u GIT_EDITOR -u GIT_EXEC_PATH -u GIT_CONFIG_PARAMETERS \
    codex exec review \
      --ignore-user-config \
      --ignore-rules \
      -m "$REVIEW_HOOK_MODEL" \
      -c "model_reasoning_effort=\"$REVIEW_HOOK_REASONING_EFFORT\"" \
      -o "$output_file" \
      - <"$prompt_file" >"$TRANSCRIPT_FILE" 2>&1
  local exit_code=$?
  set -e

  # Fail-open by DESIGN: this hook is a convenience layer, not the authority.
  # If codex is unavailable, times out, or emits no review, the commit proceeds —
  # the quality-kit validate:fast block above, the CI drift+quality gate, and
  # code review all still stand behind it. Fail-closed here would turn a codex
  # outage into a fleet-wide commit freeze. Do not "fix" this to fail-closed.
  if [ "$exit_code" -eq 0 ]; then
    if [ -s "$output_file" ]; then
      return 0
    fi
    SKIP_REASON="empty_output"
    echo "[codex-hook] Codex produced no final review output — allowing commit."
    if [ -s "$TRANSCRIPT_FILE" ]; then
      sed -n '1,120p' "$TRANSCRIPT_FILE"
    fi
    return 1
  fi

  if [ "$exit_code" -eq 124 ] || [ "$exit_code" -eq 142 ]; then
    SKIP_REASON="timeout"
    echo "[codex-hook] Codex timed out after ${REVIEW_HOOK_TIMEOUT_SECONDS}s — skipping review."
    return 124
  fi

  # Usage exhaustion is NOT transient: it persists until the quota resets, so EVERY commit
  # until then is ungated. Classify it separately and surface the reset time from the transcript.
  if [ -s "$TRANSCRIPT_FILE" ] && grep -qiE "usage limit|insufficient_quota|quota exceeded" "$TRANSCRIPT_FILE"; then
    SKIP_REASON="usage_limit"
    echo "[codex-hook] Codex USAGE LIMIT reached — the gate is unavailable, not merely slow."
    grep -iE "usage limit|try again at" "$TRANSCRIPT_FILE" | sed -n '1,2p' | sed 's/^/[codex-hook]   /'
    return 1
  fi

  # Sandbox/seatbelt/landlock initialisation failures are NOT transient either: they recur on
  # every commit until the environment is fixed. Before this reason code existed, they landed in
  # the generic bucket and needed a human to notice rather than a count.
  if [ -s "$TRANSCRIPT_FILE" ] && grep -qiE "(sandbox|seatbelt|landlock).*(failed to (initialize|initialise))|(failed to (initialize|initialise)).*(sandbox|seatbelt|landlock)" "$TRANSCRIPT_FILE"; then
    SKIP_REASON="sandbox_init"
    echo "[codex-hook] Codex sandbox could not initialise — this failure will recur on every commit until the environment is fixed."
    return 1
  fi

  SKIP_REASON="error"
  echo "[codex-hook] Codex failed to run — allowing commit."
  if [ -s "$TRANSCRIPT_FILE" ]; then
    sed -n '1,120p' "$TRANSCRIPT_FILE"
  fi
  return 1
}

# Plan documents get a DIFFERENT review: one-shot adversarial architecture
# review that never blocks the commit. Plans are design, not code — line-level
# correctness review on prose creates an unbounded iteration loop, while an
# architecture-level challenge is both higher-signal and bounded to one pass.
# If EVERY staged file lives under docs/plans/, run the architecture review
# and exit 0 regardless of findings.
NON_PLAN_FILES=$(echo "$STAGED_FILES" | grep -v '^docs/plans/' || true)
if [ -z "$NON_PLAN_FILES" ] && [ -n "$STAGED_FILES" ]; then
  echo ""
  echo "╔══════════════════════════════════════════╗"
  echo "║  Codex Architecture Review (plan doc)    ║"
  echo "╚══════════════════════════════════════════╝"
  echo ""
  echo "[codex-hook] Running one-shot adversarial architecture review."
  echo "[codex-hook] This review NEVER blocks the commit — findings are advisory."
  echo ""

  if [ "$STAGED_DIFF_BYTES" -gt "$REVIEW_HOOK_MAX_DIFF_BYTES" ]; then
    echo "[codex-hook] Plan diff is ${STAGED_DIFF_BYTES} bytes, over ${REVIEW_HOOK_MAX_DIFF_BYTES}-byte limit — skipping architecture review."
    # Emit the skip contract like every other skip path. A bare `exit 0` here left downstream
    # tooling unable to tell an oversized plan-only commit from a reviewed one.
    gate_skipped "oversize_plan_diff"
    exit 0
  fi

  {
    cat <<EOF
You are doing an ADVERSARIAL ARCHITECTURE REVIEW of the following plan document diff. This is a design document, NOT executable code. Your job is to challenge the ARCHITECTURE and DESIGN at the conceptual level, not implementation details.

DO review:
- Are the stated invariants actually preserved by the proposed approach? Can you construct a scenario where they are violated at the architecture level (not pseudocode level)?
- Are there unstated assumptions about the environment (platform, filesystem semantics, runtime, user behavior, deployment topology) that break the design if they change?
- Is there a fundamentally simpler design being ignored? Does the complexity match the actual risk/value?
- Are there boundary cases the design does not address: first-run state, crash recovery, migration, shutdown, concurrent instances, resource exhaustion, permission boundaries?
- Does the design have unstated coupling with things outside its stated scope (shared resources, external services, other subsystems)?
- Can an adversary defeat the stated privacy/correctness invariants via a path the design does not consider?
- Does the design solve the actual problem, or a proxy for it?

DO NOT review:
- Specific race conditions in pseudocode (TOCTOU, ordering, cleanup races in prose-described code)
- Variable naming, error types, exception hierarchies, or code style
- Alternative syscalls, libraries, functions, or implementation patterns
- Off-by-one errors, line-level bugs, or specific return values
- Error-handling granularity at the function level
- Any feedback that would require rewriting specific sentences of the plan

This review runs ONCE, will NEVER block the commit, and is advisory only. The implementation sprint's TDD cycle will catch code-level bugs — your job is strictly architecture-level concerns that a TDD loop would NOT catch.

Output format: use [ARCH] tags for findings. For each finding, state the architectural concern, the scenario that exposes it, and an alternative approach to consider. If the design is sound at the architecture level, output 'ARCHITECTURE SOUND' followed by a one-paragraph explanation of why the approach is defensible. Be terse — prose-level nitpicking is explicitly out of scope.

Files changed:
${STAGED_FILES}

Diff:
EOF
    cat "$DIFF_FILE"
  } >"$PROMPT_FILE"

  : >"$OUTPUT_FILE"
  if run_codex_review "$PROMPT_FILE" "$OUTPUT_FILE"; then
    cat "$OUTPUT_FILE"
  fi
  echo ""
  echo "──────────────────────────────────────────────────"
  echo "[codex-hook] Architecture review complete (advisory)."
  # Plan docs get architecture review only, never a code gate — advisory by design. Routed
  # through gate_skipped rather than echoing the marker directly, so it lands in the skip log
  # like every other ungated commit; a printed line nothing records is not evidence.
  gate_skipped "plan_doc_advisory"
  echo "──────────────────────────────────────────────────"
  exit 0
fi

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  Codex Pre-Commit Review                 ║"
echo "╚══════════════════════════════════════════╝"
echo ""

REVIEW_COMPLETED=0
REVIEW_OUTPUT=""

if [ "$STAGED_DIFF_BYTES" -gt "$REVIEW_HOOK_MAX_DIFF_BYTES" ]; then
  # Loud by design: this skip cannot be fixed by retrying or by a different reviewer, so it must
  # not read like routine chatter on the way past.
  echo "  ⚠  WARNING — THIS COMMIT IS NOT BEING REVIEWED  ⚠"
  echo "[codex-hook] Staged diff is ${STAGED_DIFF_BYTES} bytes, over the ${REVIEW_HOOK_MAX_DIFF_BYTES}-byte limit — no reviewer will see it."
  echo "[codex-hook] Split the commit if you want it reviewed. Continuing with any other commit checks."
  echo ""
  SKIP_REASON="oversize_diff"
else
  {
    cat <<EOF
Review ONLY the following staged diff for bugs, security issues, and correctness.
Do NOT search the filesystem or explore files outside this diff.
Focus exclusively on what is shown below.

Tag every actionable finding with a bracketed priority marker: [P1], [P2] or [P3].
This hook blocks on those markers; an unmarked finding is one nobody is told about.

Files changed:
${STAGED_FILES}

Diff:
EOF
    cat "$DIFF_FILE"
  } >"$PROMPT_FILE"

  : >"$OUTPUT_FILE"
  if run_codex_review "$PROMPT_FILE" "$OUTPUT_FILE"; then
    REVIEW_OUTPUT=$(cat "$OUTPUT_FILE")
    REVIEW_COMPLETED=1
    echo "$REVIEW_OUTPUT"
    echo ""
  fi
fi

# Run tsc --noEmit if staged changes touch dashboard TS/TSX
STAGED_DASHBOARD=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^dashboard/.*\.tsx?$" || true)
if [ -n "$STAGED_DASHBOARD" ]; then
  DASHBOARD_DIR="$(git rev-parse --show-toplevel)/dashboard"
  if [ -f "$DASHBOARD_DIR/package.json" ] && command -v pnpm >/dev/null 2>&1; then
    echo "[ts-hook] Running tsc --noEmit on dashboard/ (staged changes touch TS/TSX)..."
    if ! (cd "$DASHBOARD_DIR" && pnpm exec tsc --noEmit 2>&1 | tee /tmp/ts-hook-$$.log); then
      echo ""
      echo "──────────────────────────────────────────────────"
      echo "[ts-hook] BLOCKED — tsc --noEmit reported errors."
      echo "[ts-hook] Fix the type errors and retry the commit."
      echo "──────────────────────────────────────────────────"
      rm -f /tmp/ts-hook-$$.log
      exit 1
    fi
    rm -f /tmp/ts-hook-$$.log
    echo "[ts-hook] ✓ tsc --noEmit passed."
  fi
fi

if [ "$REVIEW_COMPLETED" -ne 1 ]; then
  gate_skipped
  exit 0
fi

# --- Verdict parsing ---------------------------------------------------------
# ORDER MATTERS: findings are checked BEFORE any approval signal. The reverse
# order let a conditional approval through — "LGTM apart from the [P1] SQL
# injection below" matched an unanchored, case-insensitive LGTM and exited 0
# before the [P1] check ever ran. Codex merely QUOTING a diff line containing the
# word ("// LGTM once tests pass") defeated the gate the same way.
case "$(printf '%s' "$REVIEW_OUTPUT" | codex_verdict)" in
  lgtm)
    echo "[codex-hook] ✓ Codex approved. Proceeding with commit."
    exit 0
    ;;
  clean)
    echo "[codex-hook] ✓ No issues flagged. Proceeding with commit."
    exit 0
    ;;
  drift)
    echo "──────────────────────────────────────────────────"
    echo "[codex-hook] BLOCKED — priority-shaped findings with no [Pn] marker."
    echo "[codex-hook] The review reported issues in a form this gate cannot parse,"
    echo "[codex-hook] so it was NOT evaluated. Read the review above before retrying."
    echo "──────────────────────────────────────────────────"
    ;;
  *)
    echo "──────────────────────────────────────────────────"
    echo "[codex-hook] BLOCKED — Codex flagged issues above."
    echo "[codex-hook] Fix the issues and retry the commit."
    echo "──────────────────────────────────────────────────"
    ;;
esac

# Interactive terminal: give the human a choice
if [ -t 0 ]; then
  read -r -p "Commit anyway? [y/N] " response < /dev/tty
  case "$response" in
    [yY]|[yY][eE][sS])
      echo "[codex-hook] Proceeding with commit despite review findings."
      exit 0
      ;;
  esac
fi

# Non-interactive or user said no — block
exit 1
