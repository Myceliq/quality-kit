{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)\"/.quality/format-changed-adapter.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)\"/.quality/stop-validate.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
